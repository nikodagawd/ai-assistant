<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= chat.topic %> - Presentation</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/theme/solarized.css">
</head>
<body>

<div class="reveal">
  <div class="slides">
    <% output = chat.messages.where(role: "assistant").order(:created_at).last&.content.to_s %>

    <% slides_block = output.split("===HANDOUT===")[0].to_s.sub("===SLIDES===", "").strip %>
    <% slide_split_regex = /(?:^|\n)\s*Slide\s+\d+\s*:\s*(?:\n|$)/i %>
    <% slides = slides_block.split(slide_split_regex).map(&:strip).reject(&:empty?) %>

    <% if slides.any? %>
      <% slides.each_with_index do |slide, index| %>
        <section>
          <% lines = slide.lines.map(&:strip).reject(&:empty?) %>
          <h2><%= lines.shift || "Slide #{index + 1}" %></h2>
          <% lines.each do |line| %>
            <p><%= line.sub(/\A[-*•]\s+/, "") %></p>
          <% end %>
        </section>
      <% end %>
    <% else %>
      <section>
        <h2>No slides detected</h2>
        <pre style="white-space: pre-wrap;"><%= output %></pre>
      </section>
    <% end %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.min.js"></script>
<script>
  const deck = new Reveal(document.querySelector(".reveal"), {
    hash: false,
    slideNumber: true,
    transition: "slide"
  });
  deck.initialize();
</script>

</body>
</html>
