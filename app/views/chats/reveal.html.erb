<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= @chat.topic %></title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/theme/solarized.css">

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: #fff;
      overflow: hidden;
    }

    .reveal {
      width: 100vw !important;
      height: 100vh !important;
    }
  </style>
</head>

<body>
  <div class="reveal">
    <div class="slides">

      <% slides =
        (@chat.output.presence || "")
          .split(/Slide \d+:/)
          .map(&:strip)
          .reject(&:empty?)
      %>

      <% slides.each do |slide| %>
        <section>
          <% slide.lines.each do |line| %>
            <% next if line.strip.blank? %>
            <p><%= line.strip %></p>
          <% end %>
        </section>
      <% end %>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.min.js"></script>
<script>
  Reveal.initialize({
    width: 1000,
    height: 620,

    margin: 0.08,

    minScale: 0.2,
    maxScale: 1.2,

    center: true,
    slideNumber: true,
    hash: true
  });
</script>
</body>
</html>
