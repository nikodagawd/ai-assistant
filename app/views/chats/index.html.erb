<div class="container py-4">
  <h2 class="mb-4">Your Presentation History</h2>

  <% if @chats.any? %>
    <div class="row g-4">
      <% @chats.each do |chat| %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title text-truncate"><%= chat.topic %></h5>
              <p class="card-text text-muted mb-2">
                Audience: <strong><%= chat.audience %></strong><br>
                Tone: <strong><%= chat.tone %></strong><br>
                Slides: <strong><%= chat.slides_number %></strong>
              </p>
              <p class="text-end text-muted mb-3" style="font-size: 0.85rem;">
                <%= chat.created_at.strftime("%b %d, %Y %H:%M") %>
              </p>
              <%= link_to "View Presentation", chat_path(chat), class: "btn btn-primary mt-auto" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info text-center">
      You haven't created any presentations yet.
    </div>
  <% end %>
</div>
