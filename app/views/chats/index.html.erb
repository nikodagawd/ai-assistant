
<div class="container-fluid p-4">
  <h3>Your Presentation History</h3>
  <% if @chats.any? %>
    <ul class="list-group">
      <% @chats.each do |chat| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to chat.topic, chat_path(chat) %>
          <small class="text-muted"><%= chat.created_at.strftime("%b %d, %Y %H:%M") %></small>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">You haven't created any presentations yet.</p>
  <% end %>
</div>
