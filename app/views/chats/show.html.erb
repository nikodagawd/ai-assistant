<div class="container-fluid">
  <div class="row vh-100 g-0">

    <div class="col-md-3 bg-light border-end d-flex flex-column">
      <h5 class="p-3 border-bottom">Your chats</h5>

      <ul class="list-group list-group-flush flex-grow-1 overflow-auto">
        <% current_user.chats.order(created_at: :desc).each do |chat| %>
          <li class="list-group-item <%= 'active' if chat == @chat %>">
            <%= link_to chat.topic,
                        chat_path(chat),
                        class: "text-decoration-none #{'text-white' if chat == @chat}" %>
          </li>
        <% end %>
      </ul>

      <div class="p-3 border-top">
        <%= link_to "New chat", root_path, class: "btn btn-outline-primary w-100" %>
      </div>
    </div>

    <div class="col-md-9 d-flex flex-column p-4">

      <div class="flex-grow-1 overflow-auto" style="min-height: 0;">
        <% @messages.each do |message| %>
          <% if message.role == "user" %>
            <div class="d-flex justify-content-end mb-3">
              <div class="bg-primary text-white p-3 rounded-3" style="max-width: 75%;">
                <strong>You</strong><br>
                  <div class="markdown">
                    <%= render_markdown(message.content) %>
                  </div>
              </div>
            </div>
          <% else %>
            <div class="d-flex justify-content-start mb-4">
              <div class="bg-light border p-3 rounded-3" style="max-width: 75%;">
                <strong>AI Assistant</strong><br>
                  <div class="markdown">
                    <%= render_markdown(message.content) %>
                  </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="pt-3 border-top">
        <%= form_with model: [@chat, @message], local: true, data: { turbo: false } do |f| %>
          <div class="input-group">
            <%= f.text_field :content,
                  class: "form-control",
                  placeholder: "Ask a follow-up…" %>
            <button class="btn btn-primary" type="submit">Send</button>
          </div>
        <% end %>
      </div>

    </div>

  </div>
</div>
