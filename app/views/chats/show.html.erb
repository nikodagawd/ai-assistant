<div class="container-fluid">
  <div class="row vh-100 g-0">

    <!-- Sidebar: chat history -->
    <div class="col-md-3 bg-light border-end d-flex flex-column">
      <h5 class="p-3 border-bottom">Your chats</h5>

      <ul class="list-group list-group-flush flex-grow-1 overflow-auto">
        <% current_user.chats.order(created_at: :desc).each do |chat_item| %>
          <li class="list-group-item <%= 'active' if chat_item == @chat %>">
            <%= link_to chat_item.topic,
                        chat_path(chat_item),
                        class: "text-decoration-none #{'text-white' if chat_item == @chat}" %>
            <br>
            <small class="text-muted"><%= chat_item.created_at.strftime("%b %d, %Y %H:%M") %></small>

            <% if chat_item.attachment&.attached? %>
              <div>
                <small class="text-info">📎 Attached file</small>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>

      <div class="p-3 border-top">
        <%= link_to "New chat", root_path, class: "btn btn-outline-primary w-100" %>
      </div>
    </div>

    <!-- Main content: messages + slides preview -->
    <div class="col-md-9 d-flex flex-column p-4 overflow-hidden">

      <!-- Messages list -->
      <div class="flex-grow-1 overflow-auto" style="min-height: 0;">
        <% first_assistant = @messages.detect { |m| m.role == "assistant" } %>

        <% @messages.each do |message| %>
          <% if message.role == "user" %>
            <div class="d-flex justify-content-end mb-3">
              <div class="bg-primary text-white p-3 rounded-3" style="max-width: 75%;">
                <strong>You</strong><br>
                <div class="markdown">
                  <%= render_markdown(message.content) %>
                </div>
              </div>
            </div>
          <% else %>
            <div class="d-flex justify-content-start mb-4">
              <div class="bg-light border p-3 rounded-3" style="max-width: 75%; width: 100%;">
                <strong>AI Assistant</strong><br>

                <!-- Slides preview only for the first assistant response -->
                <% if message == first_assistant %>
                  <div class="reveal preview-reveal mb-2 mt-2"
                       style="height: 500px; border: 1px solid #ccc; border-radius: 8px; padding: 10px;">
                    <div class="slides">
                      <% slides_source = message.content.to_s %>
                      <% slides = slides_source.split(/Slide \d+:/).map(&:strip).reject(&:empty?) %>

                      <% if slides.any? %>
                        <% slides.each_with_index do |slide, index| %>
                          <section>
                            <% lines = slide.lines.map(&:strip).reject(&:empty?) %>
                            <% if index == 0 %>
                              <h2><%= lines.join(" ") %></h2>
                            <% else %>
                              <h2><%= lines.shift %></h2>
                              <% lines.each do |line| %>
                                <p><%= line %></p>
                              <% end %>
                            <% end %>
                          </section>
                        <% end %>
                      <% else %>
                        <section>
                          <h2>Preview</h2>
                          <p>No slides detected (expected: "Slide 1:", "Slide 2:", etc.).</p>
                        </section>
                      <% end %>
                    </div>
                  </div>

                  <% if slides_source.present? %>
                    <div class="mb-2 mt-2">
                      <%= link_to "View Fullscreen",
                                  reveal_chat_path(@chat),
                                  target: "_blank",
                                  class: "btn btn-outline-success btn-sm" %>
                    </div>
                  <% end %>
                <% end %>

                <!-- Always render the assistant message as markdown -->
                <div class="markdown">
                  <%= render_markdown(message.content) %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Follow-up form (creates a new Message) -->
      <div class="pt-3 border-top">
        <%= form_with model: [@chat, @message], local: true, data: { turbo: false } do |f| %>
          <div class="input-group">
            <%= f.text_field :content,
                             class: "form-control",
                             placeholder: "Ask a follow-up…" %>
            <button class="btn btn-primary" type="submit">Send</button>
          </div>
        <% end %>
      </div>

    </div>

  </div>
</div>

<!-- Reveal.js (preview) -->
<script src="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/theme/solarized.css">

<script>
  Reveal.initialize({
    embedded: true,
    hash: false,
    slideNumber: true,
    transition: 'slide'
  });
</script>
