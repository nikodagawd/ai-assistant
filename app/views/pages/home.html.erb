<div class="container-fluid">
  <div class="row vh-100 g-0">


    <div class="col-md-3 bg-light border-end d-flex flex-column">
      <h5 class="p-3 border-bottom">Your chats</h5>
      <ul class="list-group flex-grow-1 overflow-auto m-0">
        <% @chats.each do |chat| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <%= link_to chat.topic, chat_path(chat), class: "text-decoration-none" %>
              <br>
              <small class="text-muted"><%= chat.created_at.strftime("%b %d, %Y %H:%M") %></small>
              <% if chat.attachment&.attached? %>
                <div><small class="text-info">📎 Attached file</small></div>
              <% end %>
            </div>


          </li>
        <% end %>
      </ul>

      <div class="p-3 border-top">
        <%= link_to "New chat", root_path, class: "btn btn-outline-primary w-100" %>
      </div>
    </div>


    <div class="col-md-9 d-flex flex-column">
      <%= form_with url: "/", method: :post, local: true, html: { multipart: true }, class: "flex-shrink-0 p-3" do |f| %>
        <div class="mb-2">
          <%= f.text_area :topic, class: "form-control", placeholder: "Enter your topic...", rows: 2 %>
        </div>

        <div class="row g-2 mb-3">
          <div class="col-md-3">
            <%= f.label :audience, "Audience" %>
            <%= f.select :audience, ["Students", "Professionals", "Investors"], {}, class: "form-select" %>
          </div>
          <div class="col-md-3">
            <%= f.label :tone, "Tone" %>
            <%= f.select :tone, ["Formal", "Casual", "Funny", "Serious"], {}, class: "form-select" %>
          </div>
          <div class="col-md-3">
            <%= f.label :slides_number, "Slides" %>
            <%= f.number_field :slides_number, class: "form-control", min: 1, max: 20 %>
          </div>
          <div class="col-md-3">
            <%= f.label :role, "Persona" %>
            <%= f.select :role, ["CEO", "Manager", "Engineer", "Intern"], {}, class: "form-select" %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :attachment, "Attach a file (PDF, Word, Image)" %>
          <%= f.file_field :attachment, class: "form-control" %>
        </div>

        <div class="text-end">
          <%= f.submit "Generate Presentation", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
