<!DOCTYPE html>
<html>
  <head>
    <title>Presentation Generator</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.css" data-turbo-track="reload">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/theme/solarized.css" data-turbo-track="reload">
    <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.3.1/dist/reveal.min.js" defer data-turbo-track="reload"></script>

  </head>

  <body style="background: linear-gradient(120deg, #fdf6f0, #e9edf8);">

    <nav class="navbar navbar-expand-lg" style="background: linear-gradient(90deg, #f7cac9, #f8b195);">
      <div class="container">
        <a class="navbar-brand fw-bold text-white" href="<%= root_path %>">Generate New Presentation</a>
        <ul class="navbar-nav ms-auto">
          <% if user_signed_in? %>
            <li class="nav-item">
              <%= link_to "Dashboard", chats_path, class: "nav-link text-white fw-semibold" %>
            </li>
            <li class="nav-item">
              <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "nav-link text-white fw-semibold" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "Sign Up", new_user_registration_path, class: "nav-link text-white fw-semibold" %>
            </li>
            <li class="nav-item">
              <%= link_to "Login", new_user_session_path, class: "nav-link text-white fw-semibold" %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>

    <%= render "shared/flashes" %>

    <div class="container mt-4">
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
